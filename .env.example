# =====================================================================
# CLINEVO SMART INBOX ASSISTANT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your values.
# NEVER commit .env with real credentials to source control.
# =====================================================================

# ---------------------------------------------------------------------
# Google GenAI Configuration (Required for Python AI Microservice)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash

# ---------------------------------------------------------------------
# Mailbox Ingestion Configuration (Spring Boot Orchestrator)
# Options: IMAP (live Gmail polling) or FIXTURE (local synthetic .eml files)
# ---------------------------------------------------------------------
INGESTION_MODE=IMAP

# IMAP Settings (Used when INGESTION_MODE=IMAP)
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=clinevo.test.inbox12@gmail.com
MAIL_IMAP_PASSWORD=your_gmail_app_password_here
MAIL_IMAP_SSL=true
MAIL_IMAP_FOLDER=INBOX
MAIL_POLL_INTERVAL_MS=15000

# ---------------------------------------------------------------------
# Microservice Network Endpoints
# ---------------------------------------------------------------------
PYTHON_AI_SERVICE_URL=http://localhost:8000
SPRING_BACKEND_URL=http://localhost:8081

# ---------------------------------------------------------------------
# Database Configuration (Spring Boot Orchestrator)
# Profiles: demo (embedded H2 Oracle mode) or prod (Oracle Database XE/19c)
# ---------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=demo

# Oracle Production Settings (Only used when SPRING_PROFILES_ACTIVE=prod)
ORACLE_DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_DB_USERNAME=smartinbox
ORACLE_DB_PASSWORD=your_oracle_password_here
